# Copia este archivo a .env.local para desarrollo. En producción, todas
# estas variables (salvo las NEXT_PUBLIC_*) se configuran solo en Vercel,
# nunca se commitean.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo ---
EMAIL_PROVIDER=smtp            # smtp | resend | brevo | ses
# smtp (Zimbra, requiere que IT abra el firewall a salientes de Vercel):
SMTP_HOST=                     # pedir a TI (Zimbra)
SMTP_PORT=587                  # 587 STARTTLS o 465 SSL
SMTP_SECURE=false
SMTP_USER=transporteprefactura@grupolaar.com
SMTP_PASSWORD=                 # solo en Vercel, nunca en el repo
# resend (EMAIL_PROVIDER=resend; API HTTPS, no requiere abrir firewall):
RESEND_API_KEY=                # solo en Vercel, nunca en el repo
EMAIL_FROM="Prefacturación Transporte LAARCOURIER <transporteprefactura@grupolaar.com>"
EMAIL_REPLY_TO=
EMAIL_API_KEY=                 # alternativa a RESEND_API_KEY para otros proveedores (brevo/ses)
EMAIL_RATE_PER_MINUTE=10
EMAIL_BATCH_SIZE=20
EMAIL_MAX_RETRIES=3
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=

# --- Jobs / cron ---
CRON_SECRET=

# --- Acceso ---
ALLOWED_EMAIL_DOMAIN=grupolaar.com
